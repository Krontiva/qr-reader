VITE_VERIFY_OTP_ENDPOINT=/verify/otp/code/email_0
VITE_AUTH_ME_ENDPOINT=/delika/onboarding/auth/me #need to add the endpoint to the api-server
VITE_USER_ROLE_ENDPOINT=/delika/onboarding/auth/me


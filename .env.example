# Xano API Configuration
# Copy this file to .env and update with your Xano credentials

# Your Xano instance base URL
# Example: https://x8ki-letl-twmt.n7.xano.io/api:your-api-group
VITE_XANO_BASE_URL=https://your-instance.xano.io/api:your-api-group

# Optional: Xano API Key (if your API requires authentication)
VITE_XANO_API_KEY=

# Delika Events & Tickets API Configuration
# Base URL for Delika API
VITE_DELIKA_API_BASE_URL=https://api-server.krontiva.africa/api:uEBBwbSs

# API Endpoints (relative to base URL)
VITE_DELIKA_EVENTS_ENDPOINT=/delika_events_table
VITE_DELIKA_TICKETS_ENDPOINT=/delika_ticket_orders_table
